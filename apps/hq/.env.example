DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
AUTH_SECRET=generate-a-random-secret-with-at-least-32-bytes

# Private file storage (Cloudflare R2 or any S3-compatible bucket).
# The bucket must NOT be public. Leave these unset to run HQ without uploads.
# R2_ENDPOINT is optional for R2 (derived from R2_ACCOUNT_ID). If set, it must be
# the S3 API endpoint (https://<ACCOUNT_ID>.r2.cloudflarestorage.com), never an
# R2 custom/public domain: signed URLs only work on the S3 API endpoint, and a
# custom domain makes the bucket publicly readable.
# Bucket CORS must allow PUT from the HQ origin with the Content-Type header.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Optional: object key prefix (default set25/<VERCEL_ENV or NODE_ENV>).
R2_KEY_PREFIX=
# Optional: max upload size in bytes (default 104857600 = 100 MB).
FILE_MAX_UPLOAD_BYTES=

# Public Store product media (Milestone 8). A SEPARATE bucket that is
# intentionally public, served from PUBLIC_MEDIA_BASE_URL (for example an R2
# custom domain such as https://media.set25.mv). Never point this at the
# private R2_BUCKET_NAME bucket. Uses the same R2 credentials as above. Its
# CORS must allow PUT from the HQ origin with the Content-Type header.
R2_PUBLIC_BUCKET_NAME=
PUBLIC_MEDIA_BASE_URL=
# Optional: key prefix inside the public bucket.
R2_PUBLIC_KEY_PREFIX=
