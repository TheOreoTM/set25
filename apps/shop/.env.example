# Same database as HQ.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Public product image host (the public media bucket's domain, no trailing
# slash). Must match PUBLIC_MEDIA_BASE_URL in HQ. Read at build time for the
# image allowlist. Leave unset to run the Store with placeholders.
PUBLIC_MEDIA_BASE_URL=

# Canonical public origin used for metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://set25.mv
