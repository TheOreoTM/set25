generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductCategory {
  KNEE_PADS
  ARM_SLEEVES
  ATHLETIC_TAPE
  GRIP_SOCKS
  OTHER
}

enum InventoryMovementType {
  OPENING_STOCK
  PURCHASE_RECEIVED
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGED
  SAMPLE
  GIVEAWAY
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum TeamType {
  SCHOOL
  CLUB
  ISLAND
  RESORT
  TOURNAMENT
  OTHER
}

enum OrderType {
  STANDARD
  PREORDER
}

enum OrderSource {
  ONLINE
  INSTAGRAM
  WHATSAPP
  MANUAL
  TEAM
}

enum FulfilmentStatus {
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PreorderStatus {
  OPEN
  DEPOSIT_PAID
  ORDERED
  IN_TRANSIT
  ARRIVED
  READY
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  PLACED
  CLOSED
  CANCELLED
}

enum ImportShipmentStatus {
  PLANNING
  SUPPLIER_SHIPPING
  CHINA_WAREHOUSE
  READY_TO_SHIP
  IN_TRANSIT
  MALDIVES_CUSTOMS
  READY_FOR_COLLECTION
  RECEIVED
  CANCELLED
}

enum CostAllocationMethod {
  BY_QUANTITY
  BY_PRODUCT_VALUE
}

enum SampleStatus {
  PENDING
  APPROVED
  REJECTED
  RETEST
}

enum MoneyDirection {
  IN
  OUT
}

enum MoneyCategory {
  OWNER_FUNDING
  OTHER_INCOME
  REFUND_RECEIVED
  SUPPLIER_PAYMENT
  CHINA_SHIPPING
  INTERNATIONAL_SHIPPING
  TAX_FEES
  PACKAGING
  MARKETING
  DELIVERY
  SOFTWARE
  EQUIPMENT
  OTHER
}

enum TaskStatus {
  TODO
  DOING
  WAITING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum AmbassadorStatus {
  PROSPECT
  ACTIVE
  PAUSED
  ENDED
}

enum ContentPlatform {
  INSTAGRAM
  TIKTOK
  BOTH
}

enum ContentType {
  REEL
  POST
  CAROUSEL
  STORY
  PHOTO
  OTHER
}

enum ContentStatus {
  IDEA
  CREATING
  READY
  SCHEDULED
  POSTED
  CANCELLED
}

enum FileStatus {
  PENDING
  AVAILABLE
  DELETED
}

enum FileAccessLevel {
  ALL_STAFF
  MANAGER_AND_OWNER
  OWNER_ONLY
}

enum FileRetentionPolicy {
  PERMANENT
  UNTIL_DATE
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventoryMovements InventoryMovement[]
  createdOrders      Order[]                  @relation("OrderCreatedBy")
  recordedPayments   Payment[]                @relation("PaymentRecordedBy")
  purchaseOrders     PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  importShipments    ImportShipment[]         @relation("ImportShipmentCreatedBy")
  importEvents       ImportShipmentEvent[]    @relation("ImportEventCreatedBy")
  samples            Sample[]                 @relation("SampleCreatedBy")
  sampleEvaluations  SampleEvaluation[]       @relation("SampleEvaluationRecordedBy")
  moneyEntries       MoneyEntry[]             @relation("MoneyEntryCreatedBy")
  createdTasks       Task[]                   @relation("TaskCreatedBy")
  assignedTasks      Task[]                   @relation("TaskAssignedTo")
  ambassadors        Ambassador[]             @relation("AmbassadorCreatedBy")
  ambassadorGrants   AmbassadorProductGrant[] @relation("AmbassadorGrantCreatedBy")
  createdContent     ContentItem[]            @relation("ContentCreatedBy")
  ownedContent       ContentItem[]            @relation("ContentOwner")
  uploadedFiles      FileAsset[]              @relation("FileCreatedBy")
  deletedFiles       FileAsset[]              @relation("FileDeletedBy")

  @@index([role, active])
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  code             String          @unique
  shortDescription String?
  description      String?
  category         ProductCategory @default(OTHER)
  status           ProductStatus   @default(DRAFT)
  retailPrice      Decimal         @db.Decimal(10, 2)
  isPublished      Boolean         @default(false)
  brandLine        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants         ProductVariant[]
  supplierProducts SupplierProduct[]
  samples          Sample[]
  contentItems     ContentItem[]
  files            FileAsset[]

  @@index([status])
  @@index([category])
  @@index([isPublished])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  size              String?
  color             String?
  cost              Decimal? @db.Decimal(10, 2)
  sellPriceOverride Decimal? @db.Decimal(10, 2)
  reorderAt         Int      @default(0)
  active            Boolean  @default(true)

  // Fast read model. Only inventory transactions may change this value.
  stockOnHand Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product            Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  orderLines         OrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  samples            Sample[]
  ambassadorGrants   AmbassadorProductGrant[]

  @@index([productId])
  @@index([active])
  @@index([stockOnHand])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  variantId      String
  type           InventoryMovementType
  quantityChange Int
  notes          String
  reference      String?
  createdById    String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())

  variant         ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy       StaffUser?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  ambassadorGrant AmbassadorProductGrant?

  @@index([variantId, createdAt])
  @@index([createdById, createdAt])
  @@index([type])
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?
  instagramHandle String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]
  tasks  Task[]
  files  FileAsset[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  type        TeamType @default(OTHER)
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
  tasks  Task[]
  files  FileAsset[]

  @@index([name])
  @@index([type])
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        Int              @unique @default(autoincrement())
  type               OrderType        @default(STANDARD)
  customerId         String?
  teamId             String?
  source             OrderSource
  notes              String?
  subtotal           Decimal          @db.Decimal(12, 2)
  discountAmount     Decimal          @default(0) @db.Decimal(12, 2)
  deliveryFee        Decimal          @default(0) @db.Decimal(12, 2)
  total              Decimal          @db.Decimal(12, 2)
  currency           String           @default("MVR")
  fulfilmentStatus   FulfilmentStatus @default(NEW)
  createdById        String
  idempotencyKey     String           @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  completedAt        DateTime?
  cancelledAt        DateTime?
  inventoryAppliedAt DateTime?

  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy    StaffUser       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        OrderLine[]
  payments     Payment[]
  preorder     PreorderDetail?
  moneyEntries MoneyEntry[]
  tasks        Task[]
  files        FileAsset[]

  @@index([createdAt])
  @@index([fulfilmentStatus, createdAt])
  @@index([type, createdAt])
  @@index([customerId, createdAt])
  @@index([teamId, createdAt])
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  variantId   String?
  productName String
  productCode String
  sku         String
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal? @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  type           PaymentType
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  notes          String?
  recordedById   String
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy StaffUser @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([recordedById, createdAt])
}

model PreorderDetail {
  id               String         @id @default(cuid())
  orderId          String         @unique
  depositRequired  Decimal        @default(0) @db.Decimal(12, 2)
  estimatedArrival DateTime?
  supplierOrdered  Boolean        @default(false)
  status           PreorderStatus @default(OPEN)
  notes            String?
  purchaseOrderId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([status, estimatedArrival])
  @@index([purchaseOrderId])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  country     String?
  contactName String?
  phone       String?
  email       String?
  website     String?
  alibabaUrl  String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]
  samples        Sample[]
  moneyEntries   MoneyEntry[]
  tasks          Task[]
  files          FileAsset[]

  @@index([name])
  @@index([active])
}

model SupplierProduct {
  id            String   @id @default(cuid())
  supplierId    String
  productId     String
  productUrl    String?
  supplierSku   String?
  moq           Int?
  sampleCost    Decimal? @db.Decimal(12, 2)
  bulkUnitPrice Decimal? @db.Decimal(12, 2)
  currency      String   @default("USD")
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([supplierId, productId])
  @@index([productId])
  @@index([supplierId, active])
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  purchaseOrderNumber Int                 @unique @default(autoincrement())
  supplierId          String
  status              PurchaseOrderStatus @default(DRAFT)
  supplierReference   String?
  currency            String              @default("USD")
  exchangeRateToMvr   Decimal             @db.Decimal(18, 6)
  placedAt            DateTime?
  expectedAt          DateTime?
  notes               String?
  createdById         String
  idempotencyKey      String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    StaffUser           @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  preorders    PreorderDetail[]
  moneyEntries MoneyEntry[]
  tasks        Task[]
  files        FileAsset[]

  @@index([supplierId, createdAt])
  @@index([status, expectedAt])
}

model PurchaseOrderLine {
  id               String   @id @default(cuid())
  purchaseOrderId  String
  variantId        String?
  productName      String
  productCode      String
  sku              String
  size             String?
  color            String?
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitCost         Decimal  @db.Decimal(12, 4)
  currency         String
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  variant       ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipmentLines ImportShipmentLine[]

  @@index([purchaseOrderId])
  @@index([variantId])
}

model ImportShipment {
  id                       String               @id @default(cuid())
  importNumber             Int                  @unique @default(autoincrement())
  status                   ImportShipmentStatus @default(PLANNING)
  freightForwarder         String
  trackingReference        String?
  estimatedDeparture       DateTime?
  departedAt               DateTime?
  estimatedArrival         DateTime?
  arrivedAt                DateTime?
  receivedAt               DateTime?
  chinaShippingMvr         Decimal              @default(0) @db.Decimal(12, 2)
  internationalShippingMvr Decimal              @default(0) @db.Decimal(12, 2)
  taxFeesMvr               Decimal              @default(0) @db.Decimal(12, 2)
  otherFeesMvr             Decimal              @default(0) @db.Decimal(12, 2)
  costAllocationMethod     CostAllocationMethod @default(BY_QUANTITY)
  notes                    String?
  createdById              String
  idempotencyKey           String               @unique
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  createdBy    StaffUser             @relation("ImportShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines        ImportShipmentLine[]
  events       ImportShipmentEvent[]
  moneyEntries MoneyEntry[]
  tasks        Task[]
  files        FileAsset[]

  @@index([status, estimatedArrival])
  @@index([createdAt])
}

model ImportShipmentLine {
  id                     String   @id @default(cuid())
  importShipmentId       String
  purchaseOrderLineId    String
  quantityShipped        Int
  quantityReceived       Int      @default(0)
  allocatedSharedCostMvr Decimal? @db.Decimal(12, 2)
  actualUnitCostMvr      Decimal? @db.Decimal(12, 4)
  createdAt              DateTime @default(now())

  importShipment    ImportShipment    @relation(fields: [importShipmentId], references: [id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)

  @@unique([importShipmentId, purchaseOrderLineId])
  @@index([purchaseOrderLineId])
}

model ImportShipmentEvent {
  id               String               @id @default(cuid())
  importShipmentId String
  status           ImportShipmentStatus
  notes            String?
  createdById      String
  createdAt        DateTime             @default(now())

  importShipment ImportShipment @relation(fields: [importShipmentId], references: [id], onDelete: Restrict)
  createdBy      StaffUser      @relation("ImportEventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([importShipmentId, createdAt])
  @@index([createdById, createdAt])
}

model Sample {
  id           String       @id @default(cuid())
  sampleNumber Int          @unique @default(autoincrement())
  supplierId   String
  productId    String?
  variantId    String?
  name         String
  sampleCost   Decimal?     @db.Decimal(12, 2)
  currency     String?
  status       SampleStatus @default(PENDING)
  orderedAt    DateTime?
  receivedAt   DateTime?
  notes        String?
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  supplier    Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdBy   StaffUser          @relation("SampleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  evaluations SampleEvaluation[]
  tasks       Task[]
  files       FileAsset[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

model SampleEvaluation {
  id           String   @id @default(cuid())
  sampleId     String
  testerName   String
  quality      Int
  comfort      Int
  fit          Int
  protection   Int
  durability   Int
  branding     Int
  value        Int
  notes        String?
  recordedById String?
  createdAt    DateTime @default(now())

  sample     Sample     @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  recordedBy StaffUser? @relation("SampleEvaluationRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([sampleId, createdAt])
  @@index([recordedById, createdAt])
}

model MoneyEntry {
  id               String         @id @default(cuid())
  direction        MoneyDirection
  category         MoneyCategory
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @default("MVR")
  occurredAt       DateTime
  description      String
  reference        String?
  notes            String?
  supplierId       String?
  purchaseOrderId  String?
  importShipmentId String?
  orderId          String?
  createdById      String
  idempotencyKey   String         @unique
  createdAt        DateTime       @default(now())

  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  importShipment ImportShipment? @relation(fields: [importShipmentId], references: [id], onDelete: SetNull)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy      StaffUser       @relation("MoneyEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([direction, occurredAt])
  @@index([category, occurredAt])
  @@index([supplierId, occurredAt])
  @@index([purchaseOrderId, occurredAt])
  @@index([importShipmentId, occurredAt])
  @@index([orderId, occurredAt])
  @@index([createdById, occurredAt])
}

model Task {
  id               String       @id @default(cuid())
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  dueAt            DateTime?
  assignedToId     String?
  createdById      String
  completedAt      DateTime?
  orderId          String?
  purchaseOrderId  String?
  importShipmentId String?
  supplierId       String?
  sampleId         String?
  customerId       String?
  teamId           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedTo     StaffUser?      @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      StaffUser       @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  importShipment ImportShipment? @relation(fields: [importShipmentId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sample         Sample?         @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([priority, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([createdById, createdAt])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([importShipmentId])
  @@index([supplierId])
  @@index([sampleId])
  @@index([customerId])
  @@index([teamId])
}

model Ambassador {
  id                String           @id @default(cuid())
  name              String
  team              String?
  position          String?
  instagramHandle   String?
  phone             String?
  email             String?
  status            AmbassadorStatus @default(PROSPECT)
  // Stored uppercase so the unique index is case-insensitive in practice.
  discountCode      String?          @unique
  discountPercent   Decimal?         @db.Decimal(5, 2)
  commissionPercent Decimal?         @db.Decimal(5, 2)
  startedAt         DateTime?
  endedAt           DateTime?
  notes             String?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  createdBy    StaffUser                @relation("AmbassadorCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  grants       AmbassadorProductGrant[]
  contentItems ContentItem[]
  files        FileAsset[]

  @@index([status, name])
  @@index([name])
}

// Append-only record of stock given to an ambassador. Product identity is
// snapshotted so later catalogue edits do not rewrite history.
model AmbassadorProductGrant {
  id                  String   @id @default(cuid())
  ambassadorId        String
  variantId           String
  inventoryMovementId String   @unique
  quantity            Int
  productName         String
  productCode         String
  sku                 String
  size                String?
  color               String?
  notes               String?
  givenAt             DateTime
  createdById         String
  idempotencyKey      String   @unique
  createdAt           DateTime @default(now())

  ambassador        Ambassador        @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  inventoryMovement InventoryMovement @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict)
  createdBy         StaffUser         @relation("AmbassadorGrantCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ambassadorId, givenAt])
  @@index([variantId])
  @@index([createdById, createdAt])
}

model ContentItem {
  id           String          @id @default(cuid())
  title        String
  platform     ContentPlatform
  type         ContentType
  status       ContentStatus   @default(IDEA)
  hook         String?
  caption      String?
  notes        String?
  publishAt    DateTime?
  postedAt     DateTime?
  externalUrl  String?
  productId    String?
  ambassadorId String?
  ownerId      String?
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  ambassador Ambassador? @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)
  owner      StaffUser?  @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy  StaffUser   @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  files      FileAsset[]

  @@index([status, publishAt])
  @@index([publishAt])
  @@index([platform])
  @@index([ownerId, status])
  @@index([productId])
  @@index([ambassadorId])
}

// Private HQ file metadata. Bytes live in private object storage under a
// generated storageKey; access is always re-checked server-side.
model FileAsset {
  id              String              @id @default(cuid())
  originalName    String
  description     String?
  storageKey      String              @unique
  mimeType        String
  sizeBytes       Int
  status          FileStatus          @default(PENDING)
  accessLevel     FileAccessLevel     @default(MANAGER_AND_OWNER)
  retentionPolicy FileRetentionPolicy @default(PERMANENT)
  retentionUntil  DateTime?

  // At most one attachment target (database check).
  productId        String?
  customerId       String?
  teamId           String?
  orderId          String?
  supplierId       String?
  purchaseOrderId  String?
  importShipmentId String?
  sampleId         String?
  ambassadorId     String?
  contentItemId    String?

  createdById String
  createdAt   DateTime  @default(now())
  finalizedAt DateTime?
  deletedAt   DateTime?
  deletedById String?

  product        Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  team           Team?           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder  PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  importShipment ImportShipment? @relation(fields: [importShipmentId], references: [id], onDelete: Restrict)
  sample         Sample?         @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  ambassador     Ambassador?     @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  contentItem    ContentItem?    @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  createdBy      StaffUser       @relation("FileCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy      StaffUser?      @relation("FileDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([accessLevel, status])
  @@index([retentionUntil])
  @@index([createdById, createdAt])
  @@index([productId])
  @@index([customerId])
  @@index([teamId])
  @@index([orderId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([importShipmentId])
  @@index([sampleId])
  @@index([ambassadorId])
  @@index([contentItemId])
}
