generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductCategory {
  KNEE_PADS
  ARM_SLEEVES
  ATHLETIC_TAPE
  GRIP_SOCKS
  OTHER
}

enum InventoryMovementType {
  OPENING_STOCK
  PURCHASE_RECEIVED
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  DAMAGED
  SAMPLE
  GIVEAWAY
}

enum StaffRole {
  OWNER
  MANAGER
  STAFF
}

enum TeamType {
  SCHOOL
  CLUB
  ISLAND
  RESORT
  TOURNAMENT
  OTHER
}

enum OrderType {
  STANDARD
  PREORDER
}

enum OrderSource {
  ONLINE
  INSTAGRAM
  WHATSAPP
  MANUAL
  TEAM
}

enum FulfilmentStatus {
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentType {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PreorderStatus {
  OPEN
  DEPOSIT_PAID
  ORDERED
  IN_TRANSIT
  ARRIVED
  READY
  COMPLETED
  CANCELLED
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(STAFF)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventoryMovements InventoryMovement[]
  createdOrders      Order[]             @relation("OrderCreatedBy")
  recordedPayments   Payment[]           @relation("PaymentRecordedBy")

  @@index([role, active])
}

model Product {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  code             String          @unique
  shortDescription String?
  description      String?
  category         ProductCategory @default(OTHER)
  status           ProductStatus   @default(DRAFT)
  retailPrice      Decimal         @db.Decimal(10, 2)
  isPublished      Boolean         @default(false)
  brandLine        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants ProductVariant[]

  @@index([status])
  @@index([category])
  @@index([isPublished])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  size              String?
  color             String?
  cost              Decimal? @db.Decimal(10, 2)
  sellPriceOverride Decimal? @db.Decimal(10, 2)
  reorderAt         Int      @default(0)
  active            Boolean  @default(true)

  // Fast read model. Only inventory transactions may change this value.
  stockOnHand Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  orderLines         OrderLine[]

  @@index([productId])
  @@index([active])
  @@index([stockOnHand])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  variantId      String
  type           InventoryMovementType
  quantityChange Int
  notes          String
  reference      String?
  createdById    String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy StaffUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([createdById, createdAt])
  @@index([type])
}

model Customer {
  id              String   @id @default(cuid())
  name            String
  phone           String
  email           String?
  instagramHandle String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([phone])
  @@index([email])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  type        TeamType @default(OTHER)
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([type])
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        Int              @unique @default(autoincrement())
  type               OrderType        @default(STANDARD)
  customerId         String?
  teamId             String?
  source             OrderSource
  notes              String?
  subtotal           Decimal          @db.Decimal(12, 2)
  discountAmount     Decimal          @default(0) @db.Decimal(12, 2)
  deliveryFee        Decimal          @default(0) @db.Decimal(12, 2)
  total              Decimal          @db.Decimal(12, 2)
  currency           String           @default("MVR")
  fulfilmentStatus   FulfilmentStatus @default(NEW)
  createdById        String
  idempotencyKey     String           @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  completedAt        DateTime?
  cancelledAt        DateTime?
  inventoryAppliedAt DateTime?

  customer  Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  team      Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy StaffUser       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines     OrderLine[]
  payments  Payment[]
  preorder  PreorderDetail?

  @@index([createdAt])
  @@index([fulfilmentStatus, createdAt])
  @@index([type, createdAt])
  @@index([customerId, createdAt])
  @@index([teamId, createdAt])
}

model OrderLine {
  id          String   @id @default(cuid())
  orderId     String
  variantId   String?
  productName String
  productCode String
  sku         String
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal? @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  type           PaymentType
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  notes          String?
  recordedById   String
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  recordedBy StaffUser @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([recordedById, createdAt])
}

model PreorderDetail {
  id               String         @id @default(cuid())
  orderId          String         @unique
  depositRequired  Decimal        @default(0) @db.Decimal(12, 2)
  estimatedArrival DateTime?
  supplierOrdered  Boolean        @default(false)
  status           PreorderStatus @default(OPEN)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, estimatedArrival])
}
